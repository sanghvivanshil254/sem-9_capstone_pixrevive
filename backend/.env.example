# Local MongoDB example. For Atlas, replace this with your Atlas URI.
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DATABASE=pixrevive

# Set these before running init_database.py. Use a unique email and a strong password.
SUPERADMIN_NAME=PixRevive Super Admin
SUPERADMIN_EMAIL=admin@example.com
SUPERADMIN_PASSWORD=replace-with-a-unique-password-at-least-12-chars
